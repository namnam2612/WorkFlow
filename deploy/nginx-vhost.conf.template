# Vhost cho __DOMAIN__ — chuyển tiếp sang container frontend (127.0.0.1:__PORT__).
# certbot sẽ tự thêm khối HTTPS (listen 443) và chuyển hướng http -> https.
server {
  listen 80;
  listen [::]:80;
  server_name __DOMAIN__;

  client_max_body_size 210m;

  location / {
    proxy_pass http://127.0.0.1:__PORT__;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # WebSocket (Socket.IO)
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $taskflow_connection_upgrade;
    proxy_read_timeout 120s;
  }
}

# Cần cho WebSocket; đặt ở http{} qua conf.d (file này được include trong http{})
map $http_upgrade $taskflow_connection_upgrade {
  default upgrade;
  ''      close;
}
