# --- MySQL (docker-compose) ---
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=taskflow
MYSQL_USER=taskflow
MYSQL_PASSWORD=taskflow_password
# Cổng MySQL map ra máy host (3307 để tránh đụng MySQL cài sẵn ở 3306)
MYSQL_PORT=3307

# --- Chỉ dùng khi chạy toàn bộ stack bằng docker compose (backend + frontend) ---
# ĐỔI các secret này (>= 32 ký tự ngẫu nhiên), ví dụ: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BACKEND_PORT=3000
FRONTEND_PORT=8080
CORS_ORIGIN=http://localhost:8080
SEED_DEFAULT_PASSWORD=Password123!
