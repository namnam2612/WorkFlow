# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Cho phép người lạ tự đăng ký (tài khoản mới luôn là member). Đặt false để chỉ admin tạo tài khoản
ALLOW_REGISTRATION=true
# Số reverse proxy đứng trước API (nginx trong docker = 1; chạy trực tiếp = 0)
TRUST_PROXY=0

# Database (docker-compose: MySQL ở cổng 3307)
DATABASE_URL="mysql://taskflow:taskflow_password@localhost:3307/taskflow"

# JWT — ĐỔI giá trị này ở môi trường thật (>= 32 ký tự ngẫu nhiên)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seed
SEED_DEFAULT_PASSWORD=Password123!
