generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  leader
  member
}

/// Nhóm của một trạng thái: hệ thống chỉ cần biết "chưa làm / đang làm / đã xong" (tính tiến độ, quá hạn, completedAt)
enum StatusCategory {
  todo
  in_progress
  done
}

/// Bộ trạng thái dùng cho công việc thường hay cho Bug (Bug có vòng đời riêng)
/// Chuyên môn của thành viên trong nhóm (để lập kế hoạch nhân lực)
enum Specialty {
  dev
  qa
  designer
  other
}

enum LeaveType {
  annual
  sick
  unpaid
  other
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
}

enum SprintStatus {
  planned
  active
  completed
}

enum StatusScope {
  task
  bug
}

/// Loại công việc: task thường, user story, bug, epic (nhóm story)
enum TaskType {
  task
  story
  bug
  epic
}

enum BugSeverity {
  minor
  major
  critical
  blocker
}

/// Môi trường phát hiện / cần sửa của Bug
enum Environment {
  dev
  staging
  prod
}

enum Priority {
  low
  medium
  high
  urgent
}

model User {
  id                 Int      @id @default(autoincrement())
  name               String   @db.VarChar(120)
  email              String   @unique @db.VarChar(190)
  passwordHash       String   @db.VarChar(100)
  role               Role     @default(member)
  avatarUrl          String?  @db.VarChar(500)
  isActive           Boolean  @default(true)
  /// Nhận thêm thông báo qua email (cần cấu hình SMTP); mặc định tắt
  emailNotifications Boolean  @default(false)
  createdAt          DateTime @default(now())

  // Hồ sơ cá nhân (tất cả tùy chọn)
  jobTitle     String? @db.VarChar(120)
  phone        String? @db.VarChar(20)
  contactEmail String? @db.VarChar(190)
  bio          String? @db.VarChar(500)
  githubUrl    String? @db.VarChar(255)
  linkedinUrl  String? @db.VarChar(255)
  facebookUrl  String? @db.VarChar(255)

  avatar      UserAvatar?
  attachments Attachment[]

  createdProjects Project[]       @relation("ProjectCreator")
  memberships     ProjectMember[]
  assignedTasks   TaskAssignee[]
  workLogs        WorkLog[]
  ledTeams        Team[]          @relation("TeamLeader")
  leaves          Leave[]         @relation("LeaveUser")
  reviewedLeaves  Leave[]         @relation("LeaveReviewer")
  teamMemberships TeamMember[]
  createdTasks    Task[]          @relation("TaskCreator")
  comments        Comment[]
  activityLogs    ActivityLog[]
  notifications   Notification[]
  refreshTokens   RefreshToken[]
}

/// Ảnh đại diện đã tải lên (lưu trong DB để không phụ thuộc ổ đĩa của container)
model UserAvatar {
  userId    Int      @id
  mime      String   @db.VarChar(20)
  data      Bytes    @db.MediumBlob
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(160)
  description     String?   @db.Text
  startDate       DateTime?
  endDate         DateTime?
  /// Incoming Webhook của Slack: sự kiện của dự án được đăng vào kênh. Là bí mật, không trả về qua API
  slackWebhookUrl String?   @db.VarChar(500)
  createdById     Int
  teamId          Int?
  createdAt       DateTime  @default(now())

  team        Team?           @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy   User            @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members     ProjectMember[]
  statuses    ProjectStatus[]
  sprints     Sprint[]
  tasks       Task[]
  attachments Attachment[]

  @@index([createdById])
  @@index([teamId])
}

/// Trạng thái tùy biến của từng dự án (cột Kanban). Có 2 bộ: công việc thường và Bug.
model ProjectStatus {
  id        Int            @id @default(autoincrement())
  projectId Int
  scope     StatusScope    @default(task)
  name      String         @db.VarChar(40)
  color     String         @db.VarChar(9)
  category  StatusCategory
  position  Int            @default(0)
  createdAt DateTime       @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([projectId, scope, name])
  @@index([projectId, scope, position])
}

model ProjectMember {
  projectId Int
  userId    Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Task {
  id             Int          @id @default(autoincrement())
  projectId      Int
  parentId       Int?
  title          String       @db.VarChar(255)
  description    String?      @db.Text
  creatorId      Int
  type           TaskType     @default(task)
  statusId       Int
  storyPoints    Int?
  sprintId       Int?
  /// Epic (task type = epic) mà story/task này thuộc về
  epicId         Int?
  /// Chỉ dùng cho type = bug
  severity       BugSeverity?
  environment    Environment?
  priority       Priority     @default(medium)
  deadline       DateTime?
  estimatedHours Float?
  actualHours    Float?
  position       Int          @default(0)
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status       ProjectStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)
  sprint       Sprint?       @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  epic         Task?         @relation("EpicChildren", fields: [epicId], references: [id], onDelete: SetNull)
  epicChildren Task[]        @relation("EpicChildren")
  workLogs     WorkLog[]
  parent       Task?         @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks     Task[]        @relation("Subtasks")
  creator      User          @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)

  assignees    TaskAssignee[]
  comments     Comment[]
  activityLogs ActivityLog[]
  attachments  Attachment[]

  @@index([deadline])
  @@index([projectId])
  @@index([projectId, statusId, position])
  @@index([statusId])
  @@index([projectId, type])
  @@index([sprintId])
  @@index([epicId])
  @@index([parentId])
}

/// Người được giao việc: một task giao cho nhiều người (bảng nối, khóa chính kép)
model TaskAssignee {
  taskId     Int
  userId     Int
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

/// File đính kèm của task HOẶC của dự án (đúng một trong hai: taskId xor projectId — service kiểm tra,
/// MySQL không cho CHECK trên cột có FK ON DELETE). File thật nằm ở UPLOAD_DIR (qua StorageService),
/// bảng này chỉ giữ metadata.
model Attachment {
  id           Int      @id @default(autoincrement())
  taskId       Int?
  projectId    Int?
  uploaderId   Int
  /// Tên gốc người dùng đặt (hiển thị và dùng khi tải về)
  originalName String   @db.VarChar(255)
  /// Tên lưu trên ổ đĩa: UUID + đuôi file, không lộ tên gốc
  storedName   String   @db.VarChar(100)
  mimeType     String   @db.VarChar(120)
  size         Int
  /// Đường dẫn tương đối so với UPLOAD_DIR (vd 2026/11/<uuid>.pdf)
  path         String   @db.VarChar(255)
  createdAt    DateTime @default(now())

  task     Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([projectId])
  @@index([uploaderId])
  @@index([createdAt])
}

model Comment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int
  content   String   @db.Text
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int
  action    String   @db.VarChar(60)
  detail    Json?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   @db.VarChar(40)
  message   String   @db.VarChar(500)
  link      String?  @db.VarChar(255)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

/// Chu kỳ làm việc (Sprint) của dự án. Mỗi dự án chỉ có tối đa một sprint đang chạy.
model Sprint {
  id              Int          @id @default(autoincrement())
  projectId       Int
  name            String       @db.VarChar(120)
  goal            String?      @db.Text
  startDate       DateTime?
  endDate         DateTime?
  status          SprintStatus @default(planned)
  /// Tổng Story Point cam kết lúc bắt đầu (đường lý tưởng của burndown)
  committedPoints Int?
  /// Tổng Story Point đã xong lúc kết thúc (velocity)
  completedPoints Int?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId, status])
}

/// Một lần ghi nhận thời gian làm việc vào công việc
model WorkLog {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int
  minutes   Int
  /// Ngày làm việc (00:00 giờ VN, lưu UTC)
  workedOn  DateTime
  note      String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId, workedOn])
}

/// Nhóm làm việc: một nhóm có thể phụ trách nhiều dự án, thành viên có chuyên môn (Dev/QA/...)
model Team {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(120)
  description String?  @db.VarChar(500)
  leaderId    Int
  createdAt   DateTime @default(now())

  leader   User         @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Restrict)
  members  TeamMember[]
  projects Project[]

  @@index([leaderId])
}

model TeamMember {
  teamId    Int
  userId    Int
  specialty Specialty @default(other)
  joinedAt  DateTime  @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@index([userId])
}

/// Đơn nghỉ phép: khoảng ngày [startDate, endDate] (cả hai đầu, 00:00 giờ VN) — dùng tính capacity thực tế của nhóm
model Leave {
  id           Int         @id @default(autoincrement())
  userId       Int
  startDate    DateTime
  endDate      DateTime
  type         LeaveType   @default(annual)
  status       LeaveStatus @default(pending)
  reason       String?     @db.VarChar(500)
  reviewedById Int?
  reviewedAt   DateTime?
  reviewNote   String?     @db.VarChar(500)
  createdAt    DateTime    @default(now())

  user     User  @relation("LeaveUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, startDate])
  @@index([status, startDate])
}
