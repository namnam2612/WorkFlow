generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  leader
  member
}

enum TaskStatus {
  todo
  in_progress
  review
  done
  blocked
}

enum Priority {
  low
  medium
  high
  urgent
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(190)
  passwordHash String   @db.VarChar(100)
  role         Role     @default(member)
  avatarUrl    String?  @db.VarChar(500)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Hồ sơ cá nhân (tất cả tùy chọn)
  jobTitle     String? @db.VarChar(120)
  phone        String? @db.VarChar(20)
  contactEmail String? @db.VarChar(190)
  bio          String? @db.VarChar(500)
  githubUrl    String? @db.VarChar(255)
  linkedinUrl  String? @db.VarChar(255)
  facebookUrl  String? @db.VarChar(255)

  avatar      UserAvatar?
  attachments Attachment[]

  createdProjects Project[]       @relation("ProjectCreator")
  memberships     ProjectMember[]
  assignedTasks   TaskAssignee[]
  createdTasks    Task[]          @relation("TaskCreator")
  comments        Comment[]
  activityLogs    ActivityLog[]
  notifications   Notification[]
  refreshTokens   RefreshToken[]
}

/// Ảnh đại diện đã tải lên (lưu trong DB để không phụ thuộc ổ đĩa của container)
model UserAvatar {
  userId    Int      @id
  mime      String   @db.VarChar(20)
  data      Bytes    @db.MediumBlob
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(160)
  description String?   @db.Text
  startDate   DateTime?
  endDate     DateTime?
  createdById Int
  createdAt   DateTime  @default(now())

  createdBy   User            @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members     ProjectMember[]
  tasks       Task[]
  attachments Attachment[]

  @@index([createdById])
}

model ProjectMember {
  projectId Int
  userId    Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Task {
  id             Int        @id @default(autoincrement())
  projectId      Int
  parentId       Int?
  title          String     @db.VarChar(255)
  description    String?    @db.Text
  creatorId      Int
  status         TaskStatus @default(todo)
  priority       Priority   @default(medium)
  deadline       DateTime?
  estimatedHours Float?
  actualHours    Float?
  position       Int        @default(0)
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Task?   @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("Subtasks")
  creator  User    @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)

  assignees    TaskAssignee[]
  comments     Comment[]
  activityLogs ActivityLog[]
  attachments  Attachment[]

  @@index([deadline])
  @@index([projectId])
  @@index([projectId, status, position])
  @@index([parentId])
}

/// Người được giao việc: một task giao cho nhiều người (bảng nối, khóa chính kép)
model TaskAssignee {
  taskId     Int
  userId     Int
  assignedAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

/// File đính kèm của task HOẶC của dự án (đúng một trong hai: taskId xor projectId — service kiểm tra,
/// MySQL không cho CHECK trên cột có FK ON DELETE). File thật nằm ở UPLOAD_DIR (qua StorageService),
/// bảng này chỉ giữ metadata.
model Attachment {
  id           Int      @id @default(autoincrement())
  taskId       Int?
  projectId    Int?
  uploaderId   Int
  /// Tên gốc người dùng đặt (hiển thị và dùng khi tải về)
  originalName String   @db.VarChar(255)
  /// Tên lưu trên ổ đĩa: UUID + đuôi file, không lộ tên gốc
  storedName   String   @db.VarChar(100)
  mimeType     String   @db.VarChar(120)
  size         Int
  /// Đường dẫn tương đối so với UPLOAD_DIR (vd 2026/11/<uuid>.pdf)
  path         String   @db.VarChar(255)
  createdAt    DateTime @default(now())

  task     Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([projectId])
  @@index([uploaderId])
  @@index([createdAt])
}

model Comment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int
  content   String   @db.Text
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int
  action    String   @db.VarChar(60)
  detail    Json?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   @db.VarChar(40)
  message   String   @db.VarChar(500)
  link      String?  @db.VarChar(255)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}
