generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  leader
  member
}

enum TaskStatus {
  todo
  in_progress
  review
  done
  blocked
}

enum Priority {
  low
  medium
  high
  urgent
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(190)
  passwordHash String   @db.VarChar(100)
  role         Role     @default(member)
  avatarUrl    String?  @db.VarChar(500)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  createdProjects Project[]       @relation("ProjectCreator")
  memberships     ProjectMember[]
  assignedTasks   Task[]          @relation("TaskAssignee")
  createdTasks    Task[]          @relation("TaskCreator")
  comments        Comment[]
  activityLogs    ActivityLog[]
  notifications   Notification[]
  refreshTokens   RefreshToken[]
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(160)
  description String?   @db.Text
  startDate   DateTime?
  endDate     DateTime?
  createdById Int
  createdAt   DateTime  @default(now())

  createdBy User            @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members   ProjectMember[]
  tasks     Task[]

  @@index([createdById])
}

model ProjectMember {
  projectId Int
  userId    Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Task {
  id             Int        @id @default(autoincrement())
  projectId      Int
  parentId       Int?
  title          String     @db.VarChar(255)
  description    String?    @db.Text
  assigneeId     Int?
  creatorId      Int
  status         TaskStatus @default(todo)
  priority       Priority   @default(medium)
  deadline       DateTime?
  estimatedHours Float?
  actualHours    Float?
  position       Int        @default(0)
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Task?   @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("Subtasks")
  assignee User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator  User    @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)

  comments     Comment[]
  activityLogs ActivityLog[]

  @@index([assigneeId, status])
  @@index([deadline])
  @@index([projectId])
  @@index([projectId, status, position])
  @@index([parentId])
}

model Comment {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int
  content   String   @db.Text
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  taskId    Int
  userId    Int
  action    String   @db.VarChar(60)
  detail    Json?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   @db.VarChar(40)
  message   String   @db.VarChar(500)
  link      String?  @db.VarChar(255)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}
